# ---------------------------------------------------------------------------
# VIDEO CLIPS
#
# Real CCTV footage and downloaded social-media video must NOT be committed to
# this repository. Keep your working clips in public/clips/ locally; only the
# synthetic placeholders generated by tools/make_demo_clips.py are tracked.
# ---------------------------------------------------------------------------
public/clips/*
!public/clips/clip_01.mp4
!public/clips/clip_02.mp4
!public/clips/clip_03.mp4
!public/clips/clip_04.mp4
!public/clips/clip_01.webm
!public/clips/clip_02.webm
!public/clips/clip_03.webm
!public/clips/clip_04.webm
!public/clips/.gitkeep
