# Copy to .env and adjust. Vite only exposes variables prefixed with VITE_.

# Where the dashboard gets its data.
#   mock = seeded events generated in the browser. No backend needed.
#   http = real REST calls to VITE_API_BASE_URL (backend_mock/ implements it).
VITE_API_MODE=mock

# Base URL of the alerting API. Used only when VITE_API_MODE=http.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Where clip files are served from. The default serves them out of
# frontend/public/, so an event with media_ref "clips/clip_01.mp4" loads
# from frontend/public/clips/clip_01.mp4.
# Point this at a media server once clips live outside the repo.
VITE_MEDIA_BASE_URL=/

# Where the Check video screen sends videos and live frames to be checked.
#   browser = the practice detector runs in the page. No server needed, and the
#             video never leaves the device. A rough guide, not the trained models.
#   http    = send to backend_mock/detect.py at VITE_API_BASE_URL, which runs
#             whichever detectors the team has registered there.
VITE_DETECT_MODE=browser
# Optional Component 03 research workflow: use `npm run dev:c3` or
# `npm run build:c3` for the checked-in .env.c3 configuration.
# VITE_C3_ENABLED=true
